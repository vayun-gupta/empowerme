# Required — Gemini API key for the adversary/coach/hint/judge agents
GEMINI_API_KEY=your_gemini_api_key_here

# Optional — defaults to local SQLite (sqlite:///./app.db).
# For hosted deployments use a Postgres URL (Neon/Supabase);
# postgres:// and postgresql:// prefixes both work.
# DATABASE_URL=postgresql://user:pass@host/dbname?sslmode=require

# Optional — comma-separated list of allowed browser origins.
# Defaults to http://localhost:3000
# CORS_ORIGINS=https://your-app.vercel.app,http://localhost:3000

# Optional — regex for additional origins (e.g. Vercel preview deploys)
# CORS_ORIGIN_REGEX=https://empowerme-.*\.vercel\.app
